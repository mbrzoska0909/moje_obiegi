<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moje obiegi</title>

  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #111;
      color: white;
      margin: 0;
      padding: 20px;
    }

    .app {
      max-width: 500px;
      margin: auto;
    }

    h1 {
      text-align: center;
    }

    .date {
      text-align: center;
      color: #aaa;
      margin-bottom: 25px;
    }

    .obiegi {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    button {
      font-size: 20px;
      padding: 16px;
      border: 0;
      border-radius: 12px;
      cursor: pointer;
    }

    #wynik {
      margin-top: 25px;
      padding: 20px;
      background: #222;
      border-radius: 16px;
      line-height: 1.6;
    }
  </style>
</head>

<body>

<div class="app">

  <h1>🚆 Moje obiegi</h1>

  <div class="date" id="data"></div>

  <div class="obiegi">
    <button onclick="pokaz(1)">1</button>
    <button onclick="pokaz(2)">2</button>
    <button onclick="pokaz(3)">3</button>
    <button onclick="pokaz(4)">4</button>
    <button onclick="pokaz(5)">5</button>
    <button onclick="pokaz(6)">6</button>
    <button onclick="pokaz(7)">7</button>
    <button onclick="pokaz(8)">8</button>
    <button onclick="pokaz(9)">9</button>
    <button onclick="pokaz(10)">10</button>
    <button onclick="pokaz(11)">11</button>
  </div>

  <div id="wynik">
    Wybierz obieg.
  </div>

</div>

<script>
  // Doba robocza zmienia się o 06:00
  const teraz = new Date();
  const dataRobocza = new Date(teraz);
  dataRobocza.setHours(dataRobocza.getHours() - 6);

  const dni = [
    "niedziela",
    "poniedziałek",
    "wtorek",
    "środa",
    "czwartek",
    "piątek",
    "sobota"
  ];

  const dzien = dni[dataRobocza.getDay()];

  document.getElementById("data").textContent =
    "Dzień roboczy: " + dzien;

  function pokaz(numer) {
    document.getElementById("wynik").innerHTML =
      "<strong>" + dzien.toUpperCase() +
      " • OBIEG " + numer + "</strong><br><br>" +
      "Tutaj za chwilę wstawimy dane obiegu.";
  }
</script>

</body>
</html>
